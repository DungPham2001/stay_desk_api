NODE_ENV=development
PORT=3000
# Cùng cluster Atlas với các app khác, mỗi app một database: staydesk
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/staydesk?retryWrites=true&w=majority
# Bắt buộc ở production (>= 32 ký tự): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Chỉ cần khi có web gọi API (app di động không cần). Phân cách bằng dấu phẩy.
CORS_ORIGINS=
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# URL công khai của API (trang /privacy và /account/delete để khai Google Play)
PUBLIC_BASE_URL=

# true = ai cũng đăng ký admin được (chỉ môi trường duyệt). Mặc định: chỉ đăng ký được khi chưa có admin nào.
REGISTRATION_OPEN=false

# Kiểm tra phiên bản app (header X-App-Version < MIN_APP_VERSION → 426)
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0

# Phiên: access token 2h, refresh token 30 ngày (xoay vòng)
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_DAYS=30

# Email đặt lại mật khẩu (Gmail App Password, KHÔNG phải mật khẩu Gmail).
# Bỏ trống SMTP_HOST ngoài production → /auth/forgot trả mã dạng devToken để thử.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StayDesk <no-reply@example.com>
RESET_CODE_MINUTES=30

# Chủ sở hữu / liên hệ trên trang chính sách quyền riêng tư
PRIVACY_OWNER=StayDesk
PRIVACY_EMAIL=

# Có giá trị thì /v1/jobs/run bắt buộc "Authorization: Bearer <CRON_SECRET>" (Vercel Cron tự gửi)
CRON_SECRET=

# Giới hạn theo IP. RATE_LIMIT=off để tắt.
RATE_READ_PER_MIN=600
RATE_WRITE_PER_MIN=180
RATE_AUTH_PER_MIN=10
RATE_REGISTER_PER_HOUR=5

# Chạy sau reverse proxy (không phải Vercel): TRUST_PROXY=true, REQUIRE_HTTPS=true
TRUST_PROXY=false
REQUIRE_HTTPS=false
